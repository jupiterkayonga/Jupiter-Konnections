---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import StoryCard from '../components/StoryCard.astro';
import Media from '../components/Media.astro';
import { destinations } from '../data/catalog';
const entries = await getCollection('entries');
const select = (slugs: string[]) => slugs.map(slug => entries.find(e => e.data.slug === slug)!).filter(entry => entry && !['draft', 'pending'].includes(entry.data.status));
const featuredDestinations = ['tanzania', 'india', 'cuba', 'iceland', 'peru', 'antarctica'].map(slug => destinations.find(destination => destination.slug === slug)!).filter(Boolean);
const guides = select(['travel-to-zanzibar', 'climbing-mount-kilimanjaro']);
const stories = select(['todo-bien-en-habana', 'kilimanjaro-full-moon-climb', 'from-rwanda-to-antarctica', 'festivals-from-india-my-journey-in-traditions-and-celebrations']);
const photoEssays = select(['portfolio/almendrones', 'portfolio/cuban-sports', 'portfolio/faces-of-india']);
---
<Base>
  <section class="hero wrap">
    <div class="hero-top"><span class="eyebrow">Travel · Photography · Human connections</span><span class="edition">A world of stories / est. 2008</span></div>
    <h1>Places, people<span class="hero-amp"> &</span><br />the stories <em>between.</em></h1>
    <div class="hero-bottom"><div class="hero-intro"><p>I’m Jupiter. A storyteller and explorer at heart.<br />Join me on a journey through the world’s colours,<br class="desktop-break" /> cultures, and the people who bring it to life.</p><a href="/journal/" class="button">Explore the journal <span aria-hidden="true">↗</span></a></div><div class="hero-stamp" aria-hidden="true"><span>JUPITER KONNECTIONS</span><svg viewBox="0 0 100 100" fill="none"><circle cx="50" cy="50" r="43"/><ellipse cx="50" cy="50" rx="19" ry="43"/><ellipse cx="50" cy="50" rx="43" ry="17"/><path d="M7 50h86M50 7v86"/></svg><span>LET’S EXPLORE TOGETHER</span></div></div>
  </section>
  <section class="featured wrap" aria-labelledby="cuba-feature-heading">
    <div class="feature-media"><a href="/destinations/cuba/" aria-label="Explore the Cuba stories and photography"><Media title="Cuba / Through the lens" destination="cuba" image="/src/assets/images/almendrones-feature-belair.jpg" alt="Chrome trim and two-tone paint catch the light on a classic American car in Cuba." /></a><span class="photo-index">IN FOCUS — CUBA</span></div>
    <div class="feature-copy"><p class="eyebrow"><span class="tiny-dot"></span> In focus · Cuba</p><h2 id="cuba-feature-heading">The colours<br />of <em>Cuba.</em></h2><p>An unexpected friendship in Havana. Classic cars full of character. Boxing and baseball through my lens. Explore the stories and photographs from my time in Cuba.</p><a class="text-link" href="/destinations/cuba/">Explore the Cuba collection <span aria-hidden="true">↗</span></a><span class="feature-coordinate">23° N &nbsp; 82° W</span></div>
  </section>
  <section class="section wrap" aria-labelledby="destinations-heading">
    <div class="section-heading"><div><p class="eyebrow">01 / Find your next connection</p><h2 id="destinations-heading">Where shall we <em>go?</em></h2></div><a href="/destinations/" class="text-link">All destinations ↗</a></div>
    <div class="destination-grid">{featuredDestinations.map((d, i) => <a class:list={['destination-tile', d.tone]} href={`/destinations/${d.slug}/`}><div class="tile-top"><span>{d.region}</span><span>{String(i + 1).padStart(2, '0')}</span></div><span class="destination-name">{d.name}</span><div class="tile-bottom"><span>{d.coordinates}</span><span class="tile-arrow" aria-hidden="true">↗</span></div></a>)}</div>
  </section>
  <section class="section wrap" aria-labelledby="stories-heading"><div class="section-heading"><div><p class="eyebrow">02 / Stories worth slowing down for</p><h2 id="stories-heading">From the <em>journal.</em></h2></div><a href="/journal/" class="text-link">All stories ↗</a></div><div class="card-grid two">{stories.map((entry, i) => <StoryCard entry={entry} number={`0${i + 1}`} />)}</div></section>
  <section class="section wrap" aria-labelledby="photography-heading"><div class="section-heading"><div><p class="eyebrow">03 / Through the lens</p><h2 id="photography-heading">Stories told in <em>photographs.</em></h2></div><a href="/portfolio/" class="text-link">All photo essays ↗</a></div><div class="card-grid">{photoEssays.map(entry => <StoryCard entry={entry} />)}</div></section>
  <section class="about-band"><div class="wrap about-inner"><div class="about-symbol" aria-hidden="true">✳</div><div><p class="eyebrow">The person behind the perspective</p><h2>Everyone has a story.<br />I tell mine through <em>photography.</em></h2><p>Born in Rwanda, based in Paris. My passion began with a camera, a safari, and a curiosity about the people I met. Those connections are still at the heart of every journey.</p><a href="/about/" class="text-link">A little more about me ↗</a></div></div></section>
  <section class="section wrap" aria-labelledby="guides-heading"><div class="section-heading"><div><p class="eyebrow">04 / For the journey ahead</p><h2 id="guides-heading">Plan with <em>perspective.</em></h2></div><a href="/travel-guides/" class="text-link">All travel guides ↗</a></div><div class="card-grid two">{guides.map(entry => <StoryCard entry={entry} />)}</div></section>
</Base>
